GITHUB_TOKEN=replace-with-your-token

# Local Governance API write guard for testing only.
# Use the same value for both so Vite can send it and the local API can verify it.
GRC_WRITE_TOKEN=replace-with-local-random-write-token
VITE_GRC_WRITE_TOKEN=replace-with-local-random-write-token
GRC_TENANT_ID=tenant-acme-us
GRC_ALLOWED_ORIGIN=http://127.0.0.1:5173
